{
  "schema_version": "2.0.0",
  "map_id": "crew-blueprint-ecosystem-boundary-map",
  "purpose": "Canonical direct-relationship map for The Crew Blueprint. Crew Blueprint has only three direct outward relationships: Production Atlas, 50yearroadmap, and Roadmapdev. No Deadhang Labor, marketstrategy, Supabase, or other repository/system is a direct Crew Blueprint dependency or learner-content source.",
  "scope": {
    "root_system": "thecrewblueprint",
    "direct_outbound_targets": [
      "production-atlas",
      "50yearroadmap",
      "roadmapdev"
    ],
    "prohibited_direct_targets": [
      "deadhang-labor",
      "marketstrategy",
      "supabase-roadmap",
      "other-business-or-market-intelligence-systems"
    ]
  },
  "systems": [
    {
      "id": "thecrewblueprint",
      "repository": "thecrewblueprint-glitch/thecrewblueprint",
      "canonical_ref": "main",
      "role": "learner education and curriculum",
      "authority": [
        "curriculum",
        "learner-facing content",
        "site implementation",
        "course evidence lineage",
        "course publication state"
      ]
    },
    {
      "id": "production-atlas",
      "repository": "thecrewblueprint-glitch/festival-atlas",
      "role": "separate employment and hiring intelligence destination",
      "authority": [
        "employer intelligence",
        "vacancy and hiring intelligence",
        "market and labor-route intelligence",
        "current industry opportunity intelligence"
      ]
    },
    {
      "id": "50yearroadmap",
      "repository": "thecrewblueprint-glitch/50yearroadmap",
      "canonical_ref": "main",
      "role": "ecosystem governance and accepted-state continuity",
      "authority": [
        "ecosystem governance",
        "repository relationships",
        "change-control authority",
        "accepted current-state continuity"
      ]
    },
    {
      "id": "roadmapdev",
      "repository": "thecrewblueprint-glitch/Roadmapdev",
      "canonical_ref": "main",
      "role": "intelligence and research engine",
      "authority": [
        "systems intelligence",
        "learner-domain evidence analysis",
        "gap analysis",
        "decision analysis",
        "cross-system provenance"
      ],
      "crew_blueprint_ingress_rule": "Only learner-domain research grounded in admissible educational sources may flow from Roadmapdev into Crew Blueprint. Hiring/market intelligence, Deadhang business intelligence, procurement research, pricing, financial, competitive, client, vendor, or operating-strategy research is prohibited from Crew Blueprint ingress."
    }
  ],
  "direct_relations": [
    {
      "from": "thecrewblueprint",
      "to": "production-atlas",
      "relation": "links_to",
      "direction": "outbound_only",
      "channel": "human_navigation",
      "allowed_use": [
        "send a learner to a separate job-search or hiring-information destination"
      ],
      "data_flow_into_crew_blueprint": false,
      "prohibited_use": [
        "copy Atlas data into Crew Blueprint",
        "use Atlas data as curriculum evidence",
        "use Atlas hiring or market data to shape course claims or assessments",
        "embed employer, pay, vacancy, market, labor-route, worker-review, or demand datasets in Crew Blueprint",
        "treat Atlas as a Crew Blueprint research dependency"
      ]
    },
    {
      "from": "50yearroadmap",
      "to": "thecrewblueprint",
      "relation": "governs",
      "direction": "inbound_governance",
      "channel": "governance",
      "allowed_use": [
        "change control",
        "authority resolution",
        "ecosystem boundary enforcement",
        "accepted-state rules"
      ]
    },
    {
      "from": "thecrewblueprint",
      "to": "50yearroadmap",
      "relation": "reports_accepted_state_to",
      "direction": "outbound_internal",
      "channel": "governance_state",
      "allowed_use": [
        "accepted-state continuity",
        "closeout metadata",
        "provenance and repository relationship state"
      ],
      "prohibited_use": [
        "export private learner data",
        "collapse curriculum into business intelligence"
      ]
    },
    {
      "from": "thecrewblueprint",
      "to": "roadmapdev",
      "relation": "supplies_admitted_learner_state_to",
      "direction": "outbound_internal",
      "channel": "intelligence",
      "allowed_use": [
        "course-state analysis",
        "evidence-gap analysis",
        "curriculum completeness analysis",
        "publication/review analysis",
        "learner-domain systems intelligence"
      ],
      "prohibited_use": [
        "turn Crew Blueprint into Deadhang business intelligence",
        "merge learner data with private commercial strategy"
      ]
    },
    {
      "from": "roadmapdev",
      "to": "thecrewblueprint",
      "relation": "returns_admissible_learner_research_to",
      "direction": "inbound_internal_filtered",
      "channel": "research",
      "allowed_use": [
        "OSHA and regulatory research",
        "recognized consensus-standard research",
        "manufacturer and technical-documentation research",
        "credential-body and legitimate educational research",
        "learner-domain gap analysis based only on admissible educational evidence"
      ],
      "admission_gate": "Must satisfy AGENTS.md section 4.0 Permanent source-domain firewall before use.",
      "prohibited_use": [
        "Atlas hiring or market intelligence",
        "Deadhang business or financial intelligence",
        "marketstrategy procurement or access research",
        "employer pay or vacancy intelligence",
        "client/vendor/pricing/insurance/procurement/competitive strategy"
      ]
    }
  ],
  "non_relations": [
    {
      "system": "deadhang-labor",
      "rule": "No direct Crew Blueprint relationship. Deadhang private/commercial information is outside the Crew Blueprint source graph."
    },
    {
      "system": "marketstrategy",
      "rule": "No direct Crew Blueprint relationship. Marketstrategy research cannot enter Crew Blueprint curriculum or learner-facing research."
    },
    {
      "system": "supabase-roadmap",
      "rule": "Not a direct Crew Blueprint edge. Any durable-state synchronization is infrastructure behind the governed 50yearroadmap/Roadmapdev contract and does not create a new content-source relationship."
    }
  ],
  "source_admission": {
    "allowed": [
      "official OSHA and regulatory material",
      "statutes, regulations, and official agency guidance",
      "recognized consensus standards, including applicable ANSI material",
      "manufacturer manuals, technical bulletins, and model-specific documentation",
      "credential-body guidance",
      "legitimate technical and educational references",
      "clearly labeled practitioner knowledge when appropriate and when no stronger source exists"
    ],
    "prohibited": [
      "Production Atlas hiring/employer/pay/market/demand/labor-route/worker-review intelligence",
      "Deadhang Labor LLC business/financial/procurement/vendor/client/pricing/insurance/market-strategy/operating intelligence",
      "marketstrategy repository research",
      "mixed packages that have not been split before admission"
    ]
  },
  "agent_navigation": {
    "course_claim_or_learning_question": [
      "thecrewblueprint:research/agent-retrieval-manifest.json",
      "thecrewblueprint:research/matrix/course_inventory.jsonl",
      "thecrewblueprint:research/matrix/content*.jsonl",
      "thecrewblueprint:research/matrix/support_edges*.jsonl",
      "thecrewblueprint:research/matrix/sources*.jsonl",
      "thecrewblueprint:research/matrix/reviews*.jsonl",
      "roadmapdev:learner-domain research only after source-domain admission check"
    ],
    "job_hiring_or_market_question": [
      "production-atlas:external destination only"
    ],
    "governance_or_authority_question": [
      "50yearroadmap:governance and accepted-state authority"
    ],
    "what_should_we_build_or_fix_next": [
      "thecrewblueprint:research/agent-retrieval-manifest.json",
      "thecrewblueprint:research/matrix/views/domain-completeness.md",
      "thecrewblueprint:research/matrix/views/unsupported.md",
      "roadmapdev:learner-domain analysis only"
    ]
  }
}

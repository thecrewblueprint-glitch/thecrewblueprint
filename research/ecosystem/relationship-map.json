{
  "schema_version": "2.1.0",
  "map_id": "crew-blueprint-ecosystem-boundary-map",
  "purpose": "Canonical direct-relationship map for The Crew Blueprint. It records ownership, navigation and governance/intelligence relationships without authorizing cross-domain content ingestion.",
  "root_system": "thecrewblueprint",
  "systems": [
    {
      "id": "thecrewblueprint",
      "repository": "thecrewblueprint-glitch/thecrewblueprint",
      "canonical_ref": "main",
      "role": "learner education and curriculum",
      "authority": ["curriculum", "learner-facing content", "course evidence lineage", "site implementation", "course publication state"]
    },
    {
      "id": "deadhang-labor",
      "role": "owner / parent business",
      "authority": ["ownership", "owner-level product direction"],
      "data_rule": "Ownership metadata and owner-authorized governance direction may cross this edge when necessary. Deadhang financial, procurement, vendor/client, pricing, insurance, market-strategy, sourcing and operating intelligence does not flow into Crew Blueprint curriculum or learner-facing systems."
    },
    {
      "id": "production-atlas",
      "repository": "thecrewblueprint-glitch/festival-atlas",
      "canonical_ref": "research-version",
      "role": "separate public employment and market-intelligence destination",
      "authority": ["employer intelligence", "event/opportunity intelligence", "market and labor-route intelligence", "IATSE/labor-organization intelligence"]
    },
    {
      "id": "50yearroadmap",
      "repository": "thecrewblueprint-glitch/50yearroadmap",
      "canonical_ref": "main",
      "role": "ecosystem governance and accepted-state continuity",
      "authority": ["ecosystem governance", "repository relationships", "change-control authority", "accepted current-state continuity"]
    },
    {
      "id": "roadmapdev",
      "repository": "thecrewblueprint-glitch/Roadmapdev",
      "canonical_ref": "main",
      "role": "intelligence and research engine",
      "authority": ["systems intelligence", "education-domain analysis", "evidence/gap analysis", "cross-system reconciliation"]
    }
  ],
  "direct_relationships": [
    {
      "from": "deadhang-labor",
      "to": "thecrewblueprint",
      "relation": "owns",
      "allowed_flow": ["ownership metadata", "owner-authorized product direction", "governance direction"],
      "prohibited_flow": ["financial data", "pricing/margins", "client/vendor data", "procurement data", "marketstrategy payload", "commercial operating intelligence"]
    },
    {
      "from": "thecrewblueprint",
      "to": "production-atlas",
      "relation": "links_to_separate_work_intelligence_product",
      "allowed_flow": ["stable URL or route identifier", "bounded navigation purpose label"],
      "prohibited_flow": ["learner records", "course bodies", "assessments", "progress state", "curriculum evidence"]
    },
    {
      "from": "production-atlas",
      "to": "thecrewblueprint",
      "relation": "links_to_separate_training_product",
      "allowed_flow": ["stable URL or learning-route identifier", "bounded navigation purpose label"],
      "prohibited_flow": ["employer datasets", "vacancy data", "pay data", "market/demand data", "labor-route data", "worker-review data", "curriculum evidence"]
    },
    {
      "from": "thecrewblueprint",
      "to": "50yearroadmap",
      "relation": "reports_accepted_state_to",
      "allowed_flow": ["governance state", "accepted-state pointers", "provenance/closeout metadata"]
    },
    {
      "from": "thecrewblueprint",
      "to": "roadmapdev",
      "relation": "participates_in_governed_intelligence_loop",
      "allowed_flow": ["source pointers", "accepted-state metadata", "education-domain research/evidence questions"],
      "prohibited_flow": ["automatic admission of Deadhang commercial intelligence", "automatic admission of Atlas employment intelligence into curriculum"]
    },
    {
      "from": "roadmapdev",
      "to": "thecrewblueprint",
      "relation": "may_supply_education_domain_analysis",
      "allowed_flow": ["explicitly educational curriculum research", "source/evidence gap analysis", "noncommercial system recommendations"],
      "condition": "Material must be verified as education-domain research and free of Deadhang commercial or Atlas employment-intelligence payload before curriculum admission."
    }
  ],
  "prohibited_direct_targets": ["marketstrategy", "supabase-roadmap", "other-business-or-market-intelligence-systems"],
  "source_admission_rule": "A relationship or navigation edge never creates curriculum-evidence authority. Learner-facing claims must be supported by admissible educational, technical, regulatory, manufacturer, consensus-standard or clearly labeled practitioner sources under AGENTS.md."
}

{
  "schema_version": "3.0.0",
  "map_id": "crew-blueprint-ecosystem-boundary-map",
  "purpose": "Canonical relationship and data-boundary map for The Crew Blueprint successor curriculum.",
  "scope": {
    "root_system": "thecrewblueprint",
    "ownership_parent": "deadhang-labor",
    "direct_outbound_targets": ["production-atlas", "50yearroadmap", "roadmapdev"],
    "prohibited_direct_content_sources": ["marketstrategy", "deadhang-commercial-intelligence"]
  },
  "systems": [
    {
      "id": "deadhang-labor",
      "role": "owner_parent",
      "authority": ["ownership", "owner_product_direction"],
      "data_rule": "Ownership/governance metadata may cross when necessary. Commercial, financial, procurement, client, vendor, pricing, insurance, sourcing and operating intelligence do not enter Crew Blueprint curriculum."
    },
    {
      "id": "thecrewblueprint",
      "repository": "thecrewblueprint-glitch/thecrewblueprint",
      "canonical_ref": "main",
      "role": "learner_education",
      "authority": ["curriculum", "instructional_evidence", "learner_facing_content", "course_publication_state"]
    },
    {
      "id": "production-atlas",
      "repository": "thecrewblueprint-glitch/festival-atlas",
      "canonical_ref": "research-version",
      "role": "public_work_and_market_intelligence",
      "authority": ["employers", "current_opportunities", "markets", "labor_routes", "labor_organizations", "public_hiring_routes"]
    },
    {
      "id": "roadmapdev",
      "repository": "thecrewblueprint-glitch/Roadmapdev",
      "canonical_ref": "main",
      "role": "private_intelligence_and_reconciliation",
      "authority": ["cross_system_analysis", "competency_demand_normalization", "curriculum_gap_analysis", "decision_support", "provenance"]
    },
    {
      "id": "50yearroadmap",
      "repository": "thecrewblueprint-glitch/50yearroadmap",
      "canonical_ref": "main",
      "role": "ecosystem_governance",
      "authority": ["change_control", "repository_relationships", "accepted_state_continuity"]
    }
  ],
  "relations": [
    {
      "from": "deadhang-labor",
      "to": "thecrewblueprint",
      "relation": "owns",
      "channel": "ownership_governance",
      "allowed": ["ownership_identity", "owner_authorized_product_direction", "minimal_required_legal_governance_metadata"],
      "prohibited": ["financials", "pricing", "margin", "clients", "vendors", "procurement", "insurance_strategy", "marketstrategy", "sourcing_methods", "operating_intelligence"]
    },
    {
      "from": "thecrewblueprint",
      "to": "production-atlas",
      "relation": "links_to",
      "channel": "human_navigation",
      "allowed": ["send learner to current work and hiring intelligence"],
      "direct_data_ingress_to_crew_blueprint": false,
      "note": "Raw Atlas records remain in Atlas. This direct link is navigation, not curriculum ingestion."
    },
    {
      "from": "production-atlas",
      "to": "roadmapdev",
      "relation": "may_supply_public_employment_evidence_to",
      "channel": "private_analysis",
      "allowed": ["competency demand analysis", "role family normalization", "responsibility-depth analysis", "market structure analysis"],
      "prohibited_projection_to_crew_blueprint": ["raw employer lists", "vacancies", "pay records", "market rankings", "worker reviews", "current opportunity records", "personal data"]
    },
    {
      "from": "roadmapdev",
      "to": "thecrewblueprint",
      "relation": "returns_filtered_curriculum_inputs_to",
      "channel": "research",
      "allowed": [
        "normalized non-identifying competency-demand signals",
        "curriculum gap analysis",
        "OSHA and regulatory research",
        "recognized consensus-standard research",
        "manufacturer and technical-documentation research",
        "credential-body and legitimate educational research",
        "learner-domain decision support"
      ],
      "admission_rule": "Demand signals may shape what is taught but are not instructional authority. Raw employment or Deadhang commercial payloads must be split out before admission."
    },
    {
      "from": "thecrewblueprint",
      "to": "roadmapdev",
      "relation": "supplies_curriculum_state_to",
      "channel": "private_intelligence",
      "allowed": ["course-state analysis", "evidence-gap analysis", "curriculum completeness analysis", "publication/review analysis"],
      "prohibited": ["learner personal data unless a separately governed product-state contract explicitly authorizes it", "conversion into Deadhang commercial strategy"]
    },
    {
      "from": "50yearroadmap",
      "to": "thecrewblueprint",
      "relation": "governs",
      "channel": "governance",
      "allowed": ["change control", "authority resolution", "ecosystem boundary enforcement", "accepted-state rules"]
    },
    {
      "from": "thecrewblueprint",
      "to": "50yearroadmap",
      "relation": "reports_accepted_state_to",
      "channel": "governance_state",
      "allowed": ["closeout metadata", "accepted-state continuity", "provenance", "repository relationship state"]
    }
  ],
  "curriculum_transformation_contract": {
    "pipeline": [
      "public employment or industry evidence",
      "Roadmapdev normalized competency-demand signal",
      "Crew Blueprint curriculum priority decision",
      "independent instructional evidence",
      "learner-facing course"
    ],
    "instructional_source_classes": [
      "OSHA and official regulatory material",
      "applicable statutes/regulations and official agency guidance",
      "recognized consensus standards including ANSI/ESTA within copyright limits",
      "manufacturer documentation",
      "legitimate technical and educational references",
      "credential-body guidance",
      "clearly labeled practitioner knowledge"
    ],
    "rule": "Employment demand can justify teaching a competency. It cannot by itself establish how a task must be performed or grant authority to perform controlled work."
  },
  "non_relations": [
    {
      "system": "marketstrategy",
      "rule": "No direct Crew Blueprint relationship. Marketstrategy is Deadhang commercial intelligence and cannot enter curriculum."
    },
    {
      "system": "supabase-roadmap",
      "rule": "Infrastructure/state synchronization does not create a new curriculum-content source relationship."
    }
  ]
}

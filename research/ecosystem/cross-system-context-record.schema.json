{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecrewblueprint.com/schemas/cross-system-context-record.schema.json",
  "title": "Crew Blueprint Cross-System Context Record",
  "description": "Reference-first envelope for using information from Roadmapdev, Production Atlas, 50yearroadmap, Supabase Roadmap, or another governed source without collapsing source authority into Crew Blueprint. Records carry provenance, freshness, applicability, allowed use, and prohibited inference. They may point to external/source-repository data rather than copying volatile payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_type",
    "source_system",
    "source_locator",
    "source_authority",
    "observed_at",
    "freshness_state",
    "applicability",
    "allowed_use",
    "prohibited_inference",
    "status"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^CB-XCTX-[A-Z0-9][A-Z0-9._-]*$"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "research_input",
        "industry_taxonomy",
        "market_context",
        "role_context",
        "source_freshness",
        "decision_analysis",
        "governance_context",
        "accepted_state_pointer",
        "historical_content_pointer",
        "gap_signal",
        "conflict_signal"
      ]
    },
    "source_system": {
      "type": "string",
      "enum": [
        "thecrewblueprint",
        "roadmapdev",
        "production-atlas",
        "50yearroadmap",
        "supabase-roadmap",
        "external-authority",
        "external-industry-source"
      ]
    },
    "source_locator": {
      "type": "string",
      "minLength": 1,
      "description": "Repository path, canonical URL, database locator, or stable source-system identifier."
    },
    "source_ref": {
      "type": ["string", "null"],
      "description": "Commit/ref/version/current frontier when available."
    },
    "source_authority": {
      "type": "string",
      "enum": [
        "canonical",
        "primary_official",
        "manufacturer",
        "standards_body",
        "certification_body",
        "employer_or_union",
        "industry_research",
        "practitioner_corroboration",
        "analytical_advisory",
        "historical_evidence",
        "governance"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_published_or_effective_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "freshness_state": {
      "type": "string",
      "enum": [
        "current_verified",
        "current_unverified",
        "time_sensitive_check_required",
        "historical",
        "superseded",
        "unknown"
      ]
    },
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "course_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "competency_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "domain_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "route_paths": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "decision_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "contexts": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "jurisdictions": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "equipment_or_system_scope": {
          "type": ["string", "null"]
        },
        "known_limits": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": ["string", "null"],
      "description": "Compact derived summary. Prefer references over copying volatile or copyrighted source bodies."
    },
    "allowed_use": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "prohibited_inference": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "evidence_state": {
      "type": "string",
      "enum": [
        "reference_only",
        "candidate_input",
        "corroborated_input",
        "accepted_support",
        "conflicted",
        "needs_evidence",
        "blocked"
      ],
      "default": "reference_only"
    },
    "decision_state": {
      "type": "string",
      "enum": [
        "not_evaluated",
        "advisory_only",
        "owner_review_needed",
        "accepted_in_crew_blueprint",
        "rejected",
        "superseded"
      ],
      "default": "not_evaluated"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "watch",
        "historical",
        "superseded",
        "blocked"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retrieved_by": {"type": ["string", "null"]},
        "retrieval_method": {"type": ["string", "null"]},
        "source_urls": {
          "type": "array",
          "items": {"type": "string", "format": "uri"}
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_system": {"const": "roadmapdev"}
        }
      },
      "then": {
        "properties": {
          "source_authority": {"const": "analytical_advisory"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_system": {"const": "supabase-roadmap"}
        }
      },
      "then": {
        "description": "Supabase Roadmap may preserve accepted structured state/provenance but does not replace the canonical source repository for Crew Blueprint curriculum or research."
      }
    }
  ]
}

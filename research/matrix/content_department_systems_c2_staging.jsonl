{"content_id":"CL-STG-C2-001-SYSTEM-ID","domain_id_primary":"D-STG","domain_ids_secondary":[],"content_type":"boundary","route_file":"courses/pathway-staging-carpentry-02-deck-systems.html","source_data_file":null,"course_id":"C-STG-DECK-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Modular Deck Systems","lesson_identifier":"System Recognition","block_identifier":"exact-system","question_identifier":"s2q1","visual_identifier":null,"learner_facing_text":"Experience with one modular staging/deck product does not establish the assembly, locking, leveling, capacity or acceptance method for another system; identify the exact system and use its controlling manufacturer/employer process.","content_classification":"safety_boundary","safety_criticality":"high","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"No assembly method is taught by this claim."}
{"content_id":"CL-STG-C2-002-UNRESOLVED","domain_id_primary":"D-STG","domain_ids_secondary":[],"content_type":"boundary","route_file":"courses/pathway-staging-carpentry-02-deck-systems.html","source_data_file":null,"course_id":"C-STG-DECK-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Modular Deck Systems","lesson_identifier":"System State","block_identifier":"unresolved-component","question_identifier":"s2q2","visual_identifier":null,"learner_facing_text":"If a component, connector or interface does not match or seat as expected, stop the assigned step and verify the part/system state through the responsible lead and exact system documentation rather than forcing, substituting or improvising.","content_classification":"safety_boundary","safety_criticality":"critical","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Recognition/report boundary only; no connector or assembly technique."}
{"content_id":"CL-STG-C2-003-ACCEPTANCE","domain_id_primary":"D-STG","domain_ids_secondary":[],"content_type":"boundary","route_file":"courses/pathway-staging-carpentry-02-deck-systems.html","source_data_file":null,"course_id":"C-STG-DECK-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Modular Deck Systems","lesson_identifier":"Inspection & Acceptance","block_identifier":"authority-boundary","question_identifier":"s2q3/s2q5","visual_identifier":null,"learner_facing_text":"A platform that looks level, solid or complete is not thereby structurally approved; final configuration, capacity and use acceptance remain with the responsible qualified/system/venue authority under the applicable product and project requirements.","content_classification":"safety_boundary","safety_criticality":"critical","authority_implication":"specialist_external","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"No structural acceptance criteria or load-capacity method is taught."}
{"content_id":"CL-STG-C2-004-WORKFLOW","domain_id_primary":"D-STG","domain_ids_secondary":["D-LOG"],"content_type":"claim","route_file":"courses/pathway-staging-carpentry-02-deck-systems.html","source_data_file":null,"course_id":"C-STG-DECK-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Modular Deck Systems","lesson_identifier":"Build Workflow","block_identifier":"assigned-plan-flow","question_identifier":"s2q4","visual_identifier":null,"learner_facing_text":"A transferable deck-system workflow is to receive/identify the actual system, organize components against the assigned build plan, track unresolved conditions, follow the responsible system procedure, report/hand off for required inspection or acceptance, and clear/reset the work area; the exact assembly sequence is product-specific.","content_classification":"cross_source_pattern","safety_criticality":"high","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Normalizes the live workflow away from a universal physical assembly sequence."}
{"content_id":"Q-STG-C2-S2Q1","domain_id_primary":"D-STG","domain_ids_secondary":[],"content_type":"question","route_file":"courses/pathway-staging-carpentry-02-deck-systems.html","source_data_file":null,"course_id":"C-STG-DECK-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Modular Deck Systems","lesson_identifier":"Knowledge Check","block_identifier":"s2q1","question_identifier":"s2q1","visual_identifier":null,"learner_facing_text":"You know how one manufacturer's staging system locks together. Can you assume another brand works the same way?","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"knowledge_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Existing scored Staging C2 question."}
{"content_id":"QR-Q-STG-C2-S2Q1","domain_id_primary":"D-STG","domain_ids_secondary":[],"content_type":"answer_rationale","route_file":"courses/pathway-staging-carpentry-02-deck-systems.html","source_data_file":null,"course_id":"C-STG-DECK-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Modular Deck Systems","lesson_identifier":"Knowledge Check","block_identifier":"s2q1-rationale","question_identifier":"s2q1","visual_identifier":null,"learner_facing_text":"No. Identify the exact current system and follow its manufacturer/employer process; prior experience with another product does not transfer its physical method or acceptance rules.","content_classification":"safety_boundary","safety_criticality":"high","authority_implication":"knowledge_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-STG-C2-001-SYSTEM-ID."}
{"content_id":"Q-STG-C2-S2Q2","domain_id_primary":"D-STG","domain_ids_secondary":[],"content_type":"question","route_file":"courses/pathway-staging-carpentry-02-deck-systems.html","source_data_file":null,"course_id":"C-STG-DECK-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Modular Deck Systems","lesson_identifier":"Knowledge Check","block_identifier":"s2q2","question_identifier":"s2q2","visual_identifier":null,"learner_facing_text":"A deck-system connector or component does not seat/match as expected. What should you do?","content_classification":"assessment_prompt","safety_criticality":"critical","authority_implication":"knowledge_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Normalized from existing scored question; no connection technique requested."}
{"content_id":"QR-Q-STG-C2-S2Q2","domain_id_primary":"D-STG","domain_ids_secondary":[],"content_type":"answer_rationale","route_file":"courses/pathway-staging-carpentry-02-deck-systems.html","source_data_file":null,"course_id":"C-STG-DECK-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Modular Deck Systems","lesson_identifier":"Knowledge Check","block_identifier":"s2q2-rationale","question_identifier":"s2q2","visual_identifier":null,"learner_facing_text":"Stop the assigned step and verify the exact part/system state with the responsible lead and system documentation. Do not force, substitute or improvise from generic deck knowledge.","content_classification":"safety_boundary","safety_criticality":"critical","authority_implication":"knowledge_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-STG-C2-002-UNRESOLVED."}

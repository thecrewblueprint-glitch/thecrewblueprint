{"content_id":"Q-STG-C2-S2Q4","domain_id_primary":"D-STG","domain_ids_secondary":["D-LOG"],"content_type":"question","route_file":"courses/pathway-staging-carpentry-02-deck-systems.html","source_data_file":null,"course_id":"C-STG-DECK-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Modular Deck Systems","lesson_identifier":"Knowledge Check","block_identifier":"s2q4","question_identifier":"s2q4","visual_identifier":null,"learner_facing_text":"When deck-system materials arrive, what is the transferable workflow principle?","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Normalized from current detailed sequence into assigned-plan workflow reasoning."}

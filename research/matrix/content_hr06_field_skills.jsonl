{"content_id":"CL-FLD-CABLE-DEPLOY-HR06-001","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LTG","D-AUD","D-VID","D-COM","D-ELC"],"content_type":"boundary","route_file":"research/SFS-U03_CABLE_DEPLOYMENT_GATHERING_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CABLE-DEPLOY-GATHER","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"ownership-release","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Before moving production cable, the learner confirms the owning department/person, release state, assigned task and approved route rather than assuming an apparently idle line may be moved.","content_classification":"crew_blueprint_framework","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Needs department/practitioner validation as a transferable live-event workflow rule."}
{"content_id":"CL-FLD-CABLE-DEPLOY-HR06-002","domain_id_primary":"D-FLD","domain_ids_secondary":["D-ELC","D-OUT"],"content_type":"claim","route_file":"research/SFS-U03_CABLE_DEPLOYMENT_GATHERING_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CABLE-DEPLOY-GATHER","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"physical-protection","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Where the cited OSHA provisions apply, cords/cables must not create covered walking/working hazards and covered flexible electrical cords must be handled so obvious crushing, pinching or other damage is not ignored.","content_classification":"source_backed_instruction","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Applicability differs among general industry, construction and specific-purpose installations; do not generalize electrical-cord rules to every production cable family."}
{"content_id":"CL-FLD-CABLE-DEPLOY-HR06-003","domain_id_primary":"D-FLD","domain_ids_secondary":["D-VID","D-COM"],"content_type":"claim","route_file":"research/SFS-U03_CABLE_DEPLOYMENT_GATHERING_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CABLE-DEPLOY-GATHER","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"family-limits","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Cable-family and manufacturer handling limits can differ materially, so a generic coiling, bend or pulling method must not override the instructions for the actual cable/assembly being handled.","content_classification":"cross_source_pattern","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Belden fiber and Neutrik opticalCON evidence demonstrate model/family-specific constraints rather than a universal production-cable rule."}
{"content_id":"CL-FLD-CABLE-DEPLOY-HR06-004","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LTG","D-AUD","D-VID","D-COM","D-ELC"],"content_type":"boundary","route_file":"research/SFS-U03_CABLE_DEPLOYMENT_GATHERING_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CABLE-DEPLOY-GATHER","tier_learning":"T2","responsibility_band":"R1","authority_class":"A0","module_identifier":null,"lesson_identifier":null,"block_identifier":"technical-authority-boundary","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Physical cable handling does not grant authority to disconnect, patch, energize, test, repair, troubleshoot, address, configure or approve the owning technical system.","content_classification":"safety_boundary","safety_criticality":"high","authority_implication":"specialist_external","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Department/employer/qualified-person authority controls technical actions."}
{"content_id":"C-FLD-CASE-BONEYARD-ORG","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LOG","D-SHP","D-OUT"],"content_type":"course","route_file":"research/SFS-U04_CASE_BONEYARD_ORGANIZATION_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CASE-BONEYARD-ORG","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":null,"question_identifier":null,"visual_identifier":null,"learner_facing_text":"Planned Field Skill: Case / Boneyard / Work-Area Organization.","content_classification":"crew_blueprint_framework","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Assigned material staging/organization only; no independent truck-pack, structural stacking, fire/life-safety or department-ownership decisions."}
{"content_id":"CL-FLD-CASE-ORG-HR06-001","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LOG","D-OUT"],"content_type":"claim","route_file":"research/SFS-U04_CASE_BONEYARD_ORGANIZATION_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CASE-BONEYARD-ORG","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"clear-paths","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Assigned case/material staging must preserve required aisles and passageways and must not obstruct covered workplace exit routes.","content_classification":"source_backed_instruction","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Actual venue/public-route requirements may add controls beyond cited OSHA workplace rules."}
{"content_id":"CL-FLD-CASE-ORG-HR06-002","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LOG","D-SHP"],"content_type":"claim","route_file":"research/SFS-U04_CASE_BONEYARD_ORGANIZATION_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CASE-BONEYARD-ORG","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"stable-storage","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Stored material should not create a sliding or collapse hazard; a learner should not invent an unstable or unsupported stack merely to make a designated area fit more equipment.","content_classification":"source_backed_instruction","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Exact stack limits remain equipment/site/manufacturer decisions."}
{"content_id":"CL-FLD-CASE-ORG-HR06-003","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LOG","D-SHP"],"content_type":"boundary","route_file":"research/SFS-U04_CASE_BONEYARD_ORGANIZATION_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CASE-BONEYARD-ORG","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"location-authority","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Final case location, structural stacking, truck-pack/load-distribution and unclear department-ownership decisions remain with the responsible production, department, logistics or venue authority rather than the learner.","content_classification":"crew_blueprint_framework","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Requires venue/department/practitioner validation for release wording."}
{"content_id":"C-FLD-WORK-AREA-RESET","domain_id_primary":"D-FLD","domain_ids_secondary":["D-SHF","D-OUT"],"content_type":"course","route_file":"research/SFS-U05_WORK_AREA_RESET_HANDOFF_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-WORK-AREA-RESET","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":null,"question_identifier":null,"visual_identifier":null,"learner_facing_text":"Planned Field Skill: Work-Area Reset and Handoff.","content_classification":"crew_blueprint_framework","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Housekeeping, path protection, tool/material return and directed handoff only; no fire/life-safety signoff or department closeout authority."}
{"content_id":"CL-FLD-RESET-HR06-001","domain_id_primary":"D-FLD","domain_ids_secondary":["D-SHF"],"content_type":"claim","route_file":"research/SFS-U05_WORK_AREA_RESET_HANDOFF_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-WORK-AREA-RESET","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"orderly-surfaces","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Where OSHA 1910.22 applies, walking-working surfaces and passageways must be maintained in an orderly condition and free of recognized surface hazards; the Field Skill translates that into assigned production housekeeping without claiming venue signoff authority.","content_classification":"source_backed_instruction","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Workplace regulation does not define every event-specific reset workflow."}
{"content_id":"CL-FLD-RESET-HR06-002","domain_id_primary":"D-FLD","domain_ids_secondary":["D-OUT"],"content_type":"claim","route_file":"research/SFS-U05_WORK_AREA_RESET_HANDOFF_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-WORK-AREA-RESET","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"exit-routes","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Covered workplace exit routes must remain free and unobstructed; cleanup or case staging is not a reason to place equipment or materials in the exit route.","content_classification":"source_backed_instruction","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Public-event/AHJ requirements may add further controls."}
{"content_id":"CL-FLD-RESET-HR06-003","domain_id_primary":"D-FLD","domain_ids_secondary":["D-SHF","D-EVD"],"content_type":"boundary","route_file":"research/SFS-U05_WORK_AREA_RESET_HANDOFF_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-WORK-AREA-RESET","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"handoff-authority","question_identifier":null,"visual_identifier":null,"learner_facing_text":"A completed work-area reset proves the assigned cleanup/handoff behavior only; it does not authorize the learner to declare a department, technical system, venue or life-safety condition accepted or closed.","content_classification":"crew_blueprint_framework","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Internal authority-state boundary."}

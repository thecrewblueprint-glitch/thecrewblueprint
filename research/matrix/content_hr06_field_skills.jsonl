{"content_id":"CL-FLD-TEAM-LIFT-HR06-001","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LOG","D-TOOLS"],"content_type":"claim","route_file":"research/SFS-U01_TEAM_LIFT_CARRY_SET_DOWN_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-TEAM-LIFT","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"claim-a","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Crew Blueprint should not teach one universal maximum manual-lift weight or fixed crew count; load weight, grip, geometry, route, visibility, stability, repetition, environment and available handling aids all affect task risk.","content_classification":"cross_source_pattern","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Do not turn OSHA's context-specific approximately-50-pound eTool language into a universal stagehand rule."}
{"content_id":"CL-FLD-TEAM-LIFT-HR06-002","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LOG","D-TOOLS"],"content_type":"claim","route_file":"research/SFS-U01_TEAM_LIFT_CARRY_SET_DOWN_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-TEAM-LIFT","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"claim-b","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Mechanical handling or a different work plan can be preferable to simply adding more people when an ordinary production item cannot be controlled under the assigned manual move.","content_classification":"source_backed_instruction","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"The responsible workplace lead selects the actual aid/method; powered-equipment operation remains outside this skill."}
{"content_id":"CL-FLD-TEAM-LIFT-HR06-003","domain_id_primary":"D-FLD","domain_ids_secondary":["D-OUT"],"content_type":"claim","route_file":"research/SFS-U01_TEAM_LIFT_CARRY_SET_DOWN_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-TEAM-LIFT","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"claim-cd","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Before an assigned team move begins, the destination and route should be known and the team should use a deliberate coordination plan with a recognized stop signal; exact commands and handling methods vary by workplace and task.","content_classification":"cross_source_pattern","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Coordination principle is transferable; exact words are not universal."}
{"content_id":"CL-FLD-TEAM-LIFT-HR06-004","domain_id_primary":"D-FLD","domain_ids_secondary":["D-EVD"],"content_type":"boundary","route_file":"research/SFS-U01_TEAM_LIFT_CARRY_SET_DOWN_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-TEAM-LIFT","tier_learning":"T2","responsibility_band":"R1","authority_class":"A2","module_identifier":null,"lesson_identifier":null,"block_identifier":"practice-boundary","question_identifier":null,"visual_identifier":null,"learner_facing_text":"An observed team-handling practice records performance on the named object, route, team and conditions; it does not create standing employer authorization for every future load or handling context.","content_classification":"crew_blueprint_framework","safety_criticality":"moderate","authority_implication":"observed_practice","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Internal evidence-state rule."}
{"content_id":"C-FLD-CART-DOLLY-MOVEMENT","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LOG","D-SHP"],"content_type":"course","route_file":"research/SFS-U02_CART_DOLLY_HAND_TRUCK_MOVEMENT_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CART-DOLLY-MOVEMENT","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":null,"question_identifier":null,"visual_identifier":null,"learner_facing_text":"Planned Field Skill: Cart / Dolly / Hand-Truck Movement.","content_classification":"crew_blueprint_framework","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Non-powered handling aids only; no powered industrial-truck, MEWP, motorized tug or other powered-equipment authority."}
{"content_id":"CL-FLD-CART-DOLLY-HR06-001","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LOG"],"content_type":"claim","route_file":"research/SFS-U02_CART_DOLLY_HAND_TRUCK_MOVEMENT_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CART-DOLLY-MOVEMENT","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"handling-aids","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Appropriate non-powered transport aids can reduce manual-handling demand when the aid, load, route and workplace plan are suitable for the task.","content_classification":"source_backed_instruction","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Does not establish a universal device choice or load limit."}
{"content_id":"CL-FLD-CART-DOLLY-HR06-002","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LOG","D-OUT"],"content_type":"claim","route_file":"research/SFS-U02_CART_DOLLY_HAND_TRUCK_MOVEMENT_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CART-DOLLY-MOVEMENT","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"visibility-route","question_identifier":null,"visual_identifier":null,"learner_facing_text":"A non-powered cart move should preserve usable route visibility and controlled movement; if the load blocks the required view or the route changes materially, the worker stops and gets a different plan.","content_classification":"cross_source_pattern","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"No universal stack-height rule is asserted."}
{"content_id":"CL-FLD-CART-DOLLY-HR06-003","domain_id_primary":"D-FLD","domain_ids_secondary":["D-LOG","D-TOOLS"],"content_type":"claim","route_file":"research/SFS-U02_CART_DOLLY_HAND_TRUCK_MOVEMENT_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CART-DOLLY-MOVEMENT","tier_learning":"T2","responsibility_band":"R1","authority_class":"A1","module_identifier":null,"lesson_identifier":null,"block_identifier":"condition-stop","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Unexpectedly high push/pull force, damaged or poorly functioning wheels/casters, load shift, or lost control are reasons to stop and report rather than force the move through.","content_classification":"source_backed_instruction","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Repair and equipment-modification decisions remain outside the learner assignment."}
{"content_id":"CL-FLD-CART-DOLLY-HR06-004","domain_id_primary":"D-FLD","domain_ids_secondary":["D-CAR"],"content_type":"boundary","route_file":"research/SFS-U02_CART_DOLLY_HAND_TRUCK_MOVEMENT_2026-08-31.md","source_data_file":null,"course_id":"C-FLD-CART-DOLLY-MOVEMENT","tier_learning":"T2","responsibility_band":"R1","authority_class":"A0","module_identifier":null,"lesson_identifier":null,"block_identifier":"powered-boundary","question_identifier":null,"visual_identifier":null,"learner_facing_text":"This Field Skill covers assigned non-powered carts, dollies and hand trucks only; it does not authorize operation of powered industrial trucks, powered pallet equipment, MEWPs, motorized tugs or other powered machinery.","content_classification":"safety_boundary","safety_criticality":"high","authority_implication":"specialist_external","publication_state":"planned","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"External employer/site training and authorization control powered-equipment operation."}

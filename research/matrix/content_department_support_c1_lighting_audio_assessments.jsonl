{"content_id":"CL-LTG-C1-006-HANDLING","domain_id_primary":"D-LTG","domain_ids_secondary":["D-EVD"],"content_type":"boundary","route_file":"courses/pathway-lighting-01-support.html","source_data_file":"scripts/course-data-lighting.mjs","course_id":"C-LTG-SUPPORT","tier_learning":"T3","responsibility_band":"R1","authority_class":"A1","module_identifier":"1","lesson_identifier":"What You Can Help With","block_identifier":"fixture-handling-points","question_identifier":"lq1","visual_identifier":null,"learner_facing_text":"Use the actual fixture/product's designated handling points and assigned method. Do not infer that a lens, yoke lock, cable or other visible component is a safe carrying point unless the product documentation/responsible lead establishes it.","content_classification":"manufacturer_or_model_procedure","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Normalizes the current 'actual handle, never lens/yoke lock/cable' language into a product-controlled handling rule."}
{"content_id":"CL-AUD-C1-006-HANDLING","domain_id_primary":"D-AUD","domain_ids_secondary":["D-EVD"],"content_type":"boundary","route_file":"courses/pathway-audio-01-support.html","source_data_file":null,"course_id":"C-AUD-SUPPORT","tier_learning":"T3","responsibility_band":"R1","authority_class":"A1","module_identifier":"1","lesson_identifier":"1.1","block_identifier":"cabinet-handling-points","question_identifier":"aq2","visual_identifier":null,"learner_facing_text":"Use the exact cabinet/product's designated handling points and assigned movement method. Do not infer that a grille, rigging pin, connector or other visible component is a carrying point unless the manufacturer/responsible lead establishes it.","content_classification":"manufacturer_or_model_procedure","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Normalizes the current absolute speaker-handle wording into product-specific handling guidance."}
{"content_id":"CL-AUD-C1-007-PLACED-GEAR","domain_id_primary":"D-AUD","domain_ids_secondary":["D-EVD"],"content_type":"boundary","route_file":"courses/pathway-audio-01-support.html","source_data_file":null,"course_id":"C-AUD-SUPPORT","tier_learning":"T3","responsibility_band":"R1","authority_class":"A1","module_identifier":"1","lesson_identifier":"1.2","block_identifier":"placed-mic-work-control","question_identifier":"aq3","visual_identifier":null,"learner_facing_text":"Equipment already placed, patched, marked or preset by the audio department should be treated as deliberate until the responsible work process clears or reassigns it; appearance alone is not permission to move it.","content_classification":"crew_blueprint_framework","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Transferable work-control rule; exact mic/preset conventions remain production specific and need practitioner validation."}

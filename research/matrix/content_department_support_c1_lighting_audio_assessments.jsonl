{"content_id":"Q-LTG-C1-LQ3","domain_id_primary":"D-LTG","domain_ids_secondary":["D-RIG","D-COM"],"content_type":"question","route_file":"courses/pathway-lighting-01-support.html","source_data_file":"scripts/course-data-lighting.mjs","course_id":"C-LTG-SUPPORT","tier_learning":"T3","responsibility_band":"R0","authority_class":"A0","module_identifier":"Knowledge Check","lesson_identifier":"Quick Knowledge Check","block_identifier":"lq3","question_identifier":"lq3","visual_identifier":null,"learner_facing_text":"Is there one universal hand-signal system used for entertainment rigging everywhere?","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"knowledge_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Existing scored Lighting C1 question; current answer's 'STOP is universal' wording requires revision."}
{"content_id":"QR-Q-LTG-C1-LQ3","domain_id_primary":"D-LTG","domain_ids_secondary":["D-RIG","D-COM"],"content_type":"answer_rationale","route_file":"courses/pathway-lighting-01-support.html","source_data_file":"scripts/course-data-lighting.mjs","course_id":"C-LTG-SUPPORT","tier_learning":"T3","responsibility_band":"R0","authority_class":"A0","module_identifier":"Knowledge Check","lesson_identifier":"Quick Knowledge Check","block_identifier":"lq3-rationale","question_identifier":"lq3","visual_identifier":null,"learner_facing_text":"No single nationwide entertainment-rigging hand-signal system controls every venue or system. Identify the designated caller/current procedure, and if communication breaks down or a safety concern arises, stop/alert/escalate under that procedure.","content_classification":"safety_boundary","safety_criticality":"high","authority_implication":"knowledge_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-LTG-C1-004-SIGNALS; intentionally removes the unsupported universal-STOP formulation."}

{"content_id":"Q-AUD-C2-A2Q4","domain_id_primary":"D-AUD","domain_ids_secondary":[],"content_type":"question","route_file":"courses/pathway-audio-02-live-systems.html","source_data_file":null,"course_id":"C-AUD-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Console Architecture","lesson_identifier":"Knowledge Check","block_identifier":"a2q4","question_identifier":"a2q4","visual_identifier":null,"learner_facing_text":"A physical cable checks out fine on a digital console, but there's still no signal. What system layer should also be considered?","content_classification":"assessment_prompt","safety_criticality":"moderate","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Normalized from existing scored question to avoid implying independent console changes."}

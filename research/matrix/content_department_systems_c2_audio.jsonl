{"content_id":"QR-Q-AUD-C2-A2Q2","domain_id_primary":"D-AUD","domain_ids_secondary":[],"content_type":"answer_rationale","route_file":"courses/pathway-audio-02-live-systems.html","source_data_file":null,"course_id":"C-AUD-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Signal Flow","lesson_identifier":"Knowledge Check","block_identifier":"a2q2-rationale","question_identifier":"a2q2","visual_identifier":null,"learner_facing_text":"Input gain/preamp is an important upstream layer to evaluate in context, but the symptom alone does not prove one universal first adjustment. Trace the responsible signal layer and coordinate changes with the system owner/operator.","content_classification":"source_backed_instruction","safety_criticality":"moderate","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-AUD-C2-002-GAIN-STAGE and intentionally narrower than the live answer."}
{"content_id":"Q-AUD-C2-A2Q3","domain_id_primary":"D-AUD","domain_ids_secondary":[],"content_type":"question","route_file":"courses/pathway-audio-02-live-systems.html","source_data_file":null,"course_id":"C-AUD-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Console Architecture","lesson_identifier":"Knowledge Check","block_identifier":"a2q3","question_identifier":"a2q3","visual_identifier":null,"learner_facing_text":"What's the difference between a pre-fader and a post-fader send?","content_classification":"assessment_prompt","safety_criticality":"low","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Existing scored Audio C2 question."}

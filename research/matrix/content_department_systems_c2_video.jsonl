{"content_id":"CL-VID-C2-001-SYSTEM-STACK","domain_id_primary":"D-VID","domain_ids_secondary":["D-ELC","D-RIG","D-STG"],"content_type":"claim","route_file":"courses/pathway-video-02-led-video-systems.html","source_data_file":null,"course_id":"C-VID-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"LED Video Systems","lesson_identifier":"System Overview","block_identifier":"system-stack","question_identifier":"v2q1","visual_identifier":null,"learner_facing_text":"A large LED display is an integrated system whose visible image depends on multiple layers such as physical support, LED panels, power, data/electronics, processing/transport and source/content; responsibility for those layers can be split among different qualified roles.","content_classification":"cross_source_pattern","safety_criticality":"moderate","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Architecture awareness only; structural, rigging and power authority remain external."}
{"content_id":"CL-VID-C2-003-PLAYBACK-PROCESSING","domain_id_primary":"D-VID","domain_ids_secondary":[],"content_type":"claim","route_file":"courses/pathway-video-02-led-video-systems.html","source_data_file":null,"course_id":"C-VID-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"LED Video Systems","lesson_identifier":"Signal & Processing","block_identifier":"playback-processing-roles","question_identifier":"v2q3","visual_identifier":null,"learner_facing_text":"Content playback/rendering and LED processing/mapping are distinct functional layers even when one production tool or operator touches both; exact product roles and workflow vary by system.","content_classification":"cross_source_pattern","safety_criticality":"low","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Role/function distinction only; no media-server or processor configuration procedure."}
{"content_id":"CL-VID-C2-004-POWER-PLANNING","domain_id_primary":"D-VID","domain_ids_secondary":["D-ELC"],"content_type":"boundary","route_file":"courses/pathway-video-02-led-video-systems.html","source_data_file":null,"course_id":"C-VID-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"LED Video Systems","lesson_identifier":"Power Awareness","block_identifier":"demand-boundary","question_identifier":"v2q4","visual_identifier":null,"learner_facing_text":"Average operating consumption alone is not a complete basis for production-power approval; actual equipment limits, peak/startup behavior, distribution design and controlling electrical rules must be handled by the responsible qualified power/electrical process.","content_classification":"safety_boundary","safety_criticality":"critical","authority_implication":"specialist_external","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"No load calculation, circuit sizing or energized-power procedure is taught."}
{"content_id":"CL-VID-C2-007-ADVANCE","domain_id_primary":"D-VID","domain_ids_secondary":["D-RIG","D-STG","D-ELC"],"content_type":"claim","route_file":"courses/pathway-video-02-led-video-systems.html","source_data_file":null,"course_id":"C-VID-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"LED Video Systems","lesson_identifier":"Advance & Integration","block_identifier":"system-advance","question_identifier":"v2q7","visual_identifier":null,"learner_facing_text":"An LED-system advance should describe the relevant display/system requirements and cross-department interfaces rather than treating the wall as panels alone; exact advance ownership and fields vary by production.","content_classification":"cross_source_pattern","safety_criticality":"moderate","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"System-scope/documentation framing only; does not approve structure, power or weather plans."}
{"content_id":"CL-VID-C2-008-DATA-PATH","domain_id_primary":"D-VID","domain_ids_secondary":[],"content_type":"claim","route_file":"courses/pathway-video-02-led-video-systems.html","source_data_file":null,"course_id":"C-VID-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"LED Video Systems","lesson_identifier":"Signal Flow","block_identifier":"downstream-symptom","question_identifier":"v2q8","visual_identifier":null,"learner_facing_text":"A downstream group of dark cabinets can be consistent with an interruption or state problem in the shared data/signal path near the transition between working and affected sections, but the symptom does not by itself establish a specific fault or authorize product service.","content_classification":"source_backed_instruction","safety_criticality":"moderate","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Fault-domain awareness only; exact diagnosis/service remains system/product controlled."}

{"content_id":"QR-Q-LTG-C2-L2Q4","domain_id_primary":"D-LTG","domain_ids_secondary":[],"content_type":"answer_rationale","route_file":"courses/pathway-lighting-02-production-flow.html","source_data_file":"scripts/course-data-lighting.mjs","course_id":"C-LTG-PRODUCTION-FLOW","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Documentation","lesson_identifier":"Knowledge Check","block_identifier":"l2q4-rationale","question_identifier":"l2q4","visual_identifier":null,"learner_facing_text":"The current lighting patch/documentation set is the map between console-facing identities and the physical/logical system; the exact artifact may be called a patch list, hookup or other production-specific name.","content_classification":"cross_source_pattern","safety_criticality":"low","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-LTG-C2-002-DOCUMENTATION and normalized away from a universal document-name claim."}
{"content_id":"Q-LTG-C2-L2Q5","domain_id_primary":"D-LTG","domain_ids_secondary":[],"content_type":"question","route_file":"courses/pathway-lighting-02-production-flow.html","source_data_file":"scripts/course-data-lighting.mjs","course_id":"C-LTG-PRODUCTION-FLOW","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Documentation","lesson_identifier":"Knowledge Check","block_identifier":"l2q5","question_identifier":"l2q5","visual_identifier":null,"learner_facing_text":"A client requests a lighting change after the rig is already built. What should happen?","content_classification":"assessment_prompt","safety_criticality":"moderate","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Existing scored question."}

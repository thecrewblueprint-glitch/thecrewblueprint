{"content_id":"QR-Q-LTG-C2-L2Q3","domain_id_primary":"D-LTG","domain_ids_secondary":[],"content_type":"answer_rationale","route_file":"courses/pathway-lighting-02-production-flow.html","source_data_file":"scripts/course-data-lighting.mjs","course_id":"C-LTG-PRODUCTION-FLOW","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"Documentation","lesson_identifier":"Knowledge Check","block_identifier":"l2q3-rationale","question_identifier":"l2q3","visual_identifier":null,"learner_facing_text":"When the production uses two-end labeling, it improves traceability during build, troubleshooting, strike and packing; it complements rather than replaces the controlling patch/documentation process.","content_classification":"cross_source_pattern","safety_criticality":"low","authority_implication":"system_reasoning","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-LTG-C2-002-DOCUMENTATION with visible practice qualifier."}

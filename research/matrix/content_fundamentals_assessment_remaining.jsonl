{"content_id":"Q-SHF-FUND-Q21","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"2","lesson_identifier":"2.1","block_identifier":"risk-change","question_identifier":"q21","visual_identifier":null,"learner_facing_text":"The same wet-floor hazard exists in a low-traffic and a high-traffic condition. Correct answer: exposure/conditions change the risk even though the hazard remains.","content_classification":"assessment_prompt","safety_criticality":"moderate","authority_implication":"awareness_only","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Tests hazard/risk distinction within Crew Blueprint's teaching model."}
{"content_id":"QR-SHF-FUND-Q21","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"2","lesson_identifier":"2.1","block_identifier":"risk-change-coaching","question_identifier":"q21","visual_identifier":null,"learner_facing_text":"Hazard identity and risk are not the same thing; traffic, duration, visibility and other exposure conditions can change risk without changing the underlying hazard.","content_classification":"crew_blueprint_framework","safety_criticality":"moderate","authority_implication":"awareness_only","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L21-HAZARD-RISK."}
{"content_id":"Q-SHF-FUND-Q22","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"2","lesson_identifier":"2.2","block_identifier":"near-miss-reporting","question_identifier":"q22","visual_identifier":null,"learner_facing_text":"A rolling case nearly enters a travel path but no injury occurs. Correct answer: report the near miss through the call's process so the underlying condition can be addressed.","content_classification":"assessment_prompt","safety_criticality":"moderate","authority_implication":"awareness_only","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Tests reporting/escalation, not NCCE as an external standard."}
{"content_id":"QR-SHF-FUND-Q22","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"2","lesson_identifier":"2.2","block_identifier":"near-miss-reporting-coaching","question_identifier":"q22","visual_identifier":null,"learner_facing_text":"A near miss is useful safety information; reporting it supports correction of the underlying condition rather than relying only on individual caution next time.","content_classification":"source_backed_instruction","safety_criticality":"moderate","authority_implication":"awareness_only","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L22-NCCE; final exact near-miss source remains desirable."}
{"content_id":"Q-SHF-FUND-Q32","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"3","lesson_identifier":"3.2","block_identifier":"unexpected-ppe","question_identifier":"q32","visual_identifier":null,"learner_facing_text":"The assigned work area requires PPE the learner did not expect. Correct answer: do not perform the covered work unprotected; use the employer/site process to obtain or resolve the required protection.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"employer_or_site_controlled","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Tests compliance with actual site/task requirements, not a universal PPE list."}
{"content_id":"QR-SHF-FUND-Q32","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"3","lesson_identifier":"3.2","block_identifier":"unexpected-ppe-coaching","question_identifier":"q32","visual_identifier":null,"learner_facing_text":"Actual hazard assessment and controlling workplace requirements determine required PPE; the learner should not substitute preference or convenience for those requirements.","content_classification":"source_backed_instruction","safety_criticality":"high","authority_implication":"employer_or_site_controlled","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L32-SITE-PPE."}
{"content_id":"Q-SHF-FUND-Q33","domain_id_primary":"D-SHF","domain_ids_secondary":["D-CAR","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"3","lesson_identifier":"3.3","block_identifier":"phase-transition-ppe","question_identifier":"q33","visual_identifier":null,"learner_facing_text":"A call changes from load-in to show-phase appearance requirements. Correct answer: follow the current production clothing direction while continuing to satisfy any still-applicable hazard/PPE requirements.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"employer_or_site_controlled","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Normalized rationale corrects the current implication that a dress-direction change necessarily means the hazard assessment changed."}
{"content_id":"QR-SHF-FUND-Q33","domain_id_primary":"D-SHF","domain_ids_secondary":["D-CAR","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"3","lesson_identifier":"3.3","block_identifier":"phase-transition-ppe-coaching","question_identifier":"q33","visual_identifier":null,"learner_facing_text":"Production appearance requirements and workplace PPE/hazard requirements are separate inputs. A worker follows both as applicable rather than assuming one automatically cancels or proves a change in the other.","content_classification":"source_backed_instruction","safety_criticality":"high","authority_implication":"employer_or_site_controlled","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L33-PHASE-PPE; live coaching wording is a revise item."}
{"content_id":"Q-SHF-FUND-Q51","domain_id_primary":"D-SHF","domain_ids_secondary":["D-LOG","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"6","lesson_identifier":"6.1","block_identifier":"unload-order","question_identifier":"q51","visual_identifier":null,"learner_facing_text":"A needed item is beyond the current unload position/restraints. Correct answer: follow the responsible loader's assigned sequence and do not bypass restraints or cargo-control decisions independently.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Tests work-control boundary; does not endorse the current universal rear/front sequence explanation."}
{"content_id":"QR-SHF-FUND-Q51","domain_id_primary":"D-SHF","domain_ids_secondary":["D-LOG","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"6","lesson_identifier":"6.1","block_identifier":"unload-order-coaching","question_identifier":"q51","visual_identifier":null,"learner_facing_text":"The general hand follows the loader/cargo-control process rather than making independent restraint or unload-order decisions. Exact trailer sequence is load-specific and externally controlled.","content_classification":"source_backed_instruction","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L61-UNLOAD-ORDER."}
{"content_id":"Q-SHF-FUND-Q52","domain_id_primary":"D-SHF","domain_ids_secondary":["D-FLD","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"6","lesson_identifier":"6.2","block_identifier":"limited-visibility","question_identifier":"q52","visual_identifier":null,"learner_facing_text":"An assigned wheeled load blocks visibility at a blind route. Correct answer: use the lead/employer's controlled method, added help or route adjustment rather than proceeding blindly.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Does not assert one universal spotter/two-person rule."}
{"content_id":"QR-SHF-FUND-Q52","domain_id_primary":"D-SHF","domain_ids_secondary":["D-FLD","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"6","lesson_identifier":"6.2","block_identifier":"limited-visibility-coaching","question_identifier":"q52","visual_identifier":null,"learner_facing_text":"Limited visibility is a reason to change the movement plan or add appropriate help under the current workplace method; crew size and exact technique depend on the actual load and route.","content_classification":"source_backed_instruction","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L62-VISIBILITY."}
{"content_id":"Q-SHF-FUND-Q53","domain_id_primary":"D-SHF","domain_ids_secondary":["D-FLD","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"6","lesson_identifier":"6.3","block_identifier":"team-coordination","question_identifier":"q53","visual_identifier":null,"learner_facing_text":"A team movement becomes uncontrolled or receives conflicting commands. Correct answer: stop the movement safely and re-establish the assigned coordinated method rather than improvising individual corrections.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Normalized assessment avoids canonizing a universal body-position or ramp-control technique."}
{"content_id":"QR-SHF-FUND-Q53","domain_id_primary":"D-SHF","domain_ids_secondary":["D-FLD","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"6","lesson_identifier":"6.3","block_identifier":"team-coordination-coaching","question_identifier":"q53","visual_identifier":null,"learner_facing_text":"Team handling depends on coordinated work control. When control is lost or directions conflict, stop/escalate and use the actual assigned method; technique depends on load, route and workplace process.","content_classification":"source_backed_instruction","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L63-TEAM-MOVE."}
{"content_id":"Q-SHF-FUND-Q54","domain_id_primary":"D-SHF","domain_ids_secondary":["D-FLD","D-LOG","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"6","lesson_identifier":"6.4","block_identifier":"loadin-integration","question_identifier":"q54","visual_identifier":null,"learner_facing_text":"During a multi-zone load-in, correct behavior is to follow the assigned workflow, preserve visibility/paths and department ownership, communicate and confirm the destination rather than optimizing for individual speed.","content_classification":"assessment_prompt","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Tests integrated work-control principles rather than specific trailer/cable procedures."}
{"content_id":"QR-SHF-FUND-Q54","domain_id_primary":"D-SHF","domain_ids_secondary":["D-FLD","D-LOG","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"6","lesson_identifier":"6.4","block_identifier":"loadin-integration-coaching","question_identifier":"q54","visual_identifier":null,"learner_facing_text":"A reliable general hand contributes to collective flow by following direction, preserving work control and reporting completion; individual speed is secondary to the actual crew process.","content_classification":"cross_source_pattern","safety_criticality":"moderate","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L64-LOADIN-INTEGRATION."}
{"content_id":"Q-SHF-FUND-Q71","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD","D-AUD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"9","lesson_identifier":"9.1","block_identifier":"support-vs-technical","question_identifier":"q71","visual_identifier":null,"learner_facing_text":"The learner is assigned physical support near technical department equipment. Correct answer: perform the assigned support and do not independently connect, modify or troubleshoot the technical system.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"specialist_external","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Tests authority state, not audio procedure."}
{"content_id":"QR-SHF-FUND-Q71","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD","D-AUD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"9","lesson_identifier":"9.1","block_identifier":"support-vs-technical-coaching","question_identifier":"q71","visual_identifier":null,"learner_facing_text":"Assigned physical support does not create technical modification authority. The responsible department/employer controls connection, configuration and troubleshooting permissions.","content_classification":"safety_boundary","safety_criticality":"high","authority_implication":"specialist_external","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L91-SUPPORT-TECHNICAL."}
{"content_id":"Q-SHF-FUND-Q72","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD","D-RIG","D-ELC"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"9","lesson_identifier":"9.2","block_identifier":"boundary-recognition","question_identifier":"q72","visual_identifier":null,"learner_facing_text":"The learner sees apparent problems or controlled equipment outside the current assignment. Correct answer: report to the responsible department, remain outside controlled/exclusion work and ask before moving performer-owned or uncertain items.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"specialist_external","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Tests permission/ownership recognition, not technical diagnosis."}
{"content_id":"QR-SHF-FUND-Q72","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD","D-RIG","D-ELC"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"9","lesson_identifier":"9.2","block_identifier":"boundary-recognition-coaching","question_identifier":"q72","visual_identifier":null,"learner_facing_text":"When ownership, system state or authority is uncertain, reporting and asking preserves work control. Crew Blueprint categories help recognition but do not themselves grant permission.","content_classification":"crew_blueprint_framework","safety_criticality":"high","authority_implication":"specialist_external","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L92-PERMISSION-CATEGORIES."}
{"content_id":"Q-SHF-FUND-Q73","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"9","lesson_identifier":"9.3","block_identifier":"mixed-scene-classification","question_identifier":"q73","visual_identifier":null,"learner_facing_text":"In a mixed backstage scene, correct behavior is to classify likely ownership/control and ask before changing uncertain department, performer-owned, show-critical or exclusion-zone items rather than moving everything based on appearance.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"awareness_only","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Object-specific examples remain heuristic and practitioner-review dependent."}
{"content_id":"QR-SHF-FUND-Q73","domain_id_primary":"D-SHF","domain_ids_secondary":["D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"9","lesson_identifier":"9.3","block_identifier":"mixed-scene-classification-coaching","question_identifier":"q73","visual_identifier":null,"learner_facing_text":"Visual familiarity is not authority. The learner should identify the controlling department/person or preserve the item/area until direction is clear.","content_classification":"crew_blueprint_framework","safety_criticality":"high","authority_implication":"awareness_only","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L93-CLASSIFICATION-PRACTICE."}
{"content_id":"Q-SHF-FUND-Q81","domain_id_primary":"D-SHF","domain_ids_secondary":["D-TOOLS","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"7","lesson_identifier":"7.1","block_identifier":"tool-possession","question_identifier":"q81","visual_identifier":null,"learner_facing_text":"The learner owns a tool and notices apparent loose hardware on department equipment. Correct answer: do not alter it independently; report it or follow the responsible lead's specific assignment.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Tests authorization, not tightening procedure."}
{"content_id":"QR-SHF-FUND-Q81","domain_id_primary":"D-SHF","domain_ids_secondary":["D-TOOLS","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"7","lesson_identifier":"7.1","block_identifier":"tool-possession-coaching","question_identifier":"q81","visual_identifier":null,"learner_facing_text":"Tool ownership or recognition is separate from task authority. Modification of department equipment remains under the responsible work process.","content_classification":"safety_boundary","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L71-TOOL-AUTH."}
{"content_id":"Q-SHF-FUND-Q82","domain_id_primary":"D-SHF","domain_ids_secondary":["D-TOOLS","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"7","lesson_identifier":"7.2","block_identifier":"defect-response","question_identifier":"q82","visual_identifier":null,"learner_facing_text":"A tool or handling item shows obvious damage or abnormal condition. Correct answer: stop using it as assigned, report the condition and follow the employer/department process rather than improvising around the defect or conducting unfamiliar tests.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Normalized question removes the live page's universal replacement/function-test implication."}
{"content_id":"QR-SHF-FUND-Q82","domain_id_primary":"D-SHF","domain_ids_secondary":["D-TOOLS","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"7","lesson_identifier":"7.2","block_identifier":"defect-response-coaching","question_identifier":"q82","visual_identifier":null,"learner_facing_text":"Obvious damage is a reason to report and use the controlling equipment process. Exact inspection or functional testing is item-, manufacturer- and task-specific.","content_classification":"source_backed_instruction","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L72-TOOL-CONDITION."}
{"content_id":"Q-SHF-FUND-Q83","domain_id_primary":"D-SHF","domain_ids_secondary":["D-FLD","D-COM","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"7","lesson_identifier":"7.3","block_identifier":"coordination-conflict","question_identifier":"q83","visual_identifier":null,"learner_facing_text":"A team handling task receives conflicting instructions or a department uses a different handling method. Correct answer: stop if coordination is unclear and follow the current responsible crew/lead's established method rather than combining competing methods.","content_classification":"assessment_prompt","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Exact words/caller placement are not universalized."}
{"content_id":"QR-SHF-FUND-Q83","domain_id_primary":"D-SHF","domain_ids_secondary":["D-FLD","D-COM","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R1","authority_class":"A1","module_identifier":"7","lesson_identifier":"7.3","block_identifier":"coordination-conflict-coaching","question_identifier":"q83","visual_identifier":null,"learner_facing_text":"Coordinated handling requires one understood method for the current task. When direction conflicts, preserve control and clarify rather than continuing under mixed commands.","content_classification":"cross_source_pattern","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L73-TEAM-METHOD."}
{"content_id":"Q-SHF-FUND-Q101","domain_id_primary":"D-SHF","domain_ids_secondary":["D-CAR","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"10","lesson_identifier":"10.1","block_identifier":"hiring-honesty","question_identifier":"q101","visual_identifier":null,"learner_facing_text":"An applicant has transferable moving/warehouse experience but no specialist rigging training. Correct answer: describe transferable experience accurately and state the specialist limitation honestly.","content_classification":"assessment_prompt","safety_criticality":"moderate","authority_implication":"career_navigation","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Tests truthful representation, not hiring outcome guarantees."}
{"content_id":"QR-SHF-FUND-Q101","domain_id_primary":"D-SHF","domain_ids_secondary":["D-CAR","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"10","lesson_identifier":"10.1","block_identifier":"hiring-honesty-coaching","question_identifier":"q101","visual_identifier":null,"learner_facing_text":"Transferable experience is valuable, but observing or performing adjacent work is not the same as specialist training/qualification. Accurate skill-state representation protects both hiring trust and work-control boundaries.","content_classification":"cross_source_pattern","safety_criticality":"moderate","authority_implication":"career_navigation","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L101-HIRING-HONESTY."}
{"content_id":"Q-SHF-FUND-Q102","domain_id_primary":"D-SHF","domain_ids_secondary":["D-CAR","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"10","lesson_identifier":"10.2","block_identifier":"callback-patterns","question_identifier":"q102","visual_identifier":null,"learner_facing_text":"Two early-career workers have similar capability but differ in reliability, preparation, communication and safety behavior. Correct answer: recurring employer/local evidence supports reliability/professionalism as important callback factors, without guaranteeing an outcome.","content_classification":"assessment_prompt","safety_criticality":"low","authority_implication":"career_navigation","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"No fixed callback score or call-count threshold is asserted."}
{"content_id":"QR-SHF-FUND-Q102","domain_id_primary":"D-SHF","domain_ids_secondary":["D-CAR","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"10","lesson_identifier":"10.2","block_identifier":"callback-patterns-coaching","question_identifier":"q102","visual_identifier":null,"learner_facing_text":"Reliability, punctuality, professionalism, teamwork, safety and willingness to learn recur as desired behaviors, but actual callbacks and assignments are employer/local decisions and are not guaranteed by a universal formula.","content_classification":"cross_source_pattern","safety_criticality":"low","authority_implication":"career_navigation","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L102-CALLBACKS."}
{"content_id":"Q-SHF-FUND-Q103","domain_id_primary":"D-SHF","domain_ids_secondary":["D-CAR","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"10","lesson_identifier":"10.3","block_identifier":"specialization-interest","question_identifier":"q103","visual_identifier":null,"learner_facing_text":"A worker wants more responsibility in a technical department. Correct answer: express interest, build knowledge, seek appropriate training/supervision/support opportunities and obtain the actual authority required rather than modifying systems independently.","content_classification":"assessment_prompt","safety_criticality":"moderate","authority_implication":"career_navigation","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Does not require an informal invitation as the only legitimate entry pathway."}
{"content_id":"QR-SHF-FUND-Q103","domain_id_primary":"D-SHF","domain_ids_secondary":["D-CAR","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"10","lesson_identifier":"10.3","block_identifier":"specialization-interest-coaching","question_identifier":"q103","visual_identifier":null,"learner_facing_text":"Specialization can proceed through multiple legitimate hiring/training/referral/supervised pathways, but self-study or interest alone does not establish work authority.","content_classification":"cross_source_pattern","safety_criticality":"moderate","authority_implication":"career_navigation","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L103-SPECIALIZATION."}
{"content_id":"Q-SHF-FUND-Q104","domain_id_primary":"D-SHF","domain_ids_secondary":["D-CAR","D-EVD"],"content_type":"question","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"10","lesson_identifier":"10.4","block_identifier":"early-call-priority","question_identifier":"q104","visual_identifier":null,"learner_facing_text":"A new worker has limited early-call learning time. Crew Blueprint's preferred answer is to establish preparation, communication, work-control, equipment awareness, feedback and department-boundary fundamentals before treating specialization as independent authority.","content_classification":"assessment_prompt","safety_criticality":"low","authority_implication":"career_navigation","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Explicitly an internal development recommendation, not a national probation model."}
{"content_id":"QR-SHF-FUND-Q104","domain_id_primary":"D-SHF","domain_ids_secondary":["D-CAR","D-EVD"],"content_type":"answer_rationale","route_file":"courses/stagehand-fundamentals.html","source_data_file":null,"course_id":"C-SHF-FUNDAMENTALS","tier_learning":"T1","responsibility_band":"R0","authority_class":"A0","module_identifier":"10","lesson_identifier":"10.4","block_identifier":"early-call-priority-coaching","question_identifier":"q104","visual_identifier":null,"learner_facing_text":"The sequence is Crew Blueprint's instructional prioritization. Employers, locals, venues, prior experience and actual opportunities can change the worker's pace or order without invalidating the foundational competencies.","content_classification":"crew_blueprint_framework","safety_criticality":"low","authority_implication":"career_navigation","publication_state":"live","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Derived from CL-SHF-FUND-L104-EARLY-FOCUS."}
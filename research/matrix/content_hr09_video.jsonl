{"content_id":"CL-VID-SYSTEMS-HR09-001","domain_id_primary":"D-VID","domain_ids_secondary":[],"content_type":"claim","route_file":"courses/pathway-video-02-led-video-systems.html","source_data_file":null,"course_id":"C-VID-SYSTEMS","tier_learning":"T4","responsibility_band":"R1","authority_class":"A0","module_identifier":"LED Video Systems","lesson_identifier":"Pixel Pitch & Equipment","block_identifier":"pixel-pitch-selection","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Pixel pitch affects pixel density and viewing suitability, but it is only one factor in selecting a display for a real viewing requirement.","content_classification":"source_backed_instruction","safety_criticality":"low","authority_implication":"knowledge_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"AVIXA viewing-image-size evidence supports requirements-based display selection; exact product choice remains project/system specific."}
{"content_id":"CL-VID-SYSTEMS-HR09-002","domain_id_primary":"D-VID","domain_ids_secondary":[],"content_type":"claim","route_file":"courses/pathway-video-02-led-video-systems.html","source_data_file":null,"course_id":"C-VID-SYSTEMS","tier_learning":"T4","responsibility_band":"R1","authority_class":"A0","module_identifier":"LED Video Systems","lesson_identifier":"Pixel Pitch & Equipment","block_identifier":"system-image-performance","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Image performance is a property of the installed system and viewing environment, not one isolated panel specification.","content_classification":"source_backed_instruction","safety_criticality":"low","authority_implication":"knowledge_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Supported by AVIXA whole-system contrast/performance framing."}
{"content_id":"CL-VID-SYSTEMS-HR09-003","domain_id_primary":"D-VID","domain_ids_secondary":["D-OUT"],"content_type":"claim","route_file":"courses/pathway-video-02-led-video-systems.html","source_data_file":null,"course_id":"C-VID-SYSTEMS","tier_learning":"T4","responsibility_band":"R1","authority_class":"A0","module_identifier":"LED Video Systems","lesson_identifier":"Outdoor & Weather","block_identifier":"ip-rating-scope","question_identifier":null,"visual_identifier":null,"learner_facing_text":"An IP rating describes enclosure ingress protection within its scope; it does not by itself establish wind resistance, structural approval, lightning safety, or universal all-weather suitability.","content_classification":"source_backed_instruction","safety_criticality":"high","authority_implication":"awareness_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"IEC 60529 supports IP-code scope; exclusions beyond ingress are retained as a conservative boundary and require the actual structural/weather authority for positive approval claims."}
{"content_id":"CL-VID-SUPPORT-HR09-004","domain_id_primary":"D-VID","domain_ids_secondary":[],"content_type":"boundary","route_file":"courses/pathway-video-01-support.html","source_data_file":null,"course_id":"C-VID-SUPPORT","tier_learning":"T3","responsibility_band":"R1","authority_class":"A1","module_identifier":"Support Fundamentals","lesson_identifier":"Learn the System, Not the Brand","block_identifier":"product-specific-method","question_identifier":null,"visual_identifier":null,"learner_facing_text":"LED cabinet handling, locking, connecting, curving, stacking/hanging, processor behavior, and storage details vary by product family; an exact practical method must be tied to the actual manufacturer/model and responsible lead.","content_classification":"safety_boundary","safety_criticality":"high","authority_implication":"assigned_support","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Manufacturer pages support material product variation. This claim intentionally avoids teaching any locking/assembly sequence."}
{"content_id":"CL-VID-SYSTEMS-HR09-005","domain_id_primary":"D-VID","domain_ids_secondary":["D-RIG","D-STG","D-ELC"],"content_type":"boundary","route_file":"courses/pathway-video-02-led-video-systems.html","source_data_file":null,"course_id":"C-VID-SYSTEMS","tier_learning":"T4","responsibility_band":"R1","authority_class":"A0","module_identifier":"LED Video Systems","lesson_identifier":"Structural Support","block_identifier":"structural-authority","question_identifier":null,"visual_identifier":null,"learner_facing_text":"A functioning image does not establish structural, rigging, power, wind-plan, or venue/AHJ acceptance; those decisions remain with the responsible qualified authorities.","content_classification":"safety_boundary","safety_criticality":"critical","authority_implication":"awareness_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Cross-domain authority boundary consistent with HR-01/02/03. This record does not provide structural or rigging procedure."}
{"content_id":"CL-VID-SYSTEMS-HR09-006","domain_id_primary":"D-VID","domain_ids_secondary":[],"content_type":"claim","route_file":"courses/pathway-video-02-led-video-systems.html","source_data_file":null,"course_id":"C-VID-SYSTEMS","tier_learning":"T4","responsibility_band":"R2","authority_class":"A0","module_identifier":"LED Video Systems","lesson_identifier":"Signal Flow & Redundancy","block_identifier":"redundancy-model-specific","question_identifier":null,"visual_identifier":null,"learner_facing_text":"A backup signal, processor, or data path provides useful redundancy only when the actual system supports it and the configured backup state is current and tested.","content_classification":"source_backed_instruction","safety_criticality":"moderate","authority_implication":"knowledge_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Brompton documentation provides a current manufacturer example; implementation remains product-specific."}
{"content_id":"CL-VID-ARCH-HR09-007","domain_id_primary":"D-VID","domain_ids_secondary":["D-RIG","D-ELC","D-STG"],"content_type":"boundary","route_file":"courses/pathway-video-03-system-architecture.html","source_data_file":"scripts/course-data-advanced.mjs","course_id":"C-VID-SYSTEM-ARCH","tier_learning":"T7","responsibility_band":"R5","authority_class":"A0","module_identifier":"Requirements & Boundaries","lesson_identifier":"Design From Viewing Needs","block_identifier":"advanced-authority-boundary","question_identifier":null,"visual_identifier":null,"learner_facing_text":"Advanced display-system architecture learning does not grant structural, rigging, production-power, firmware/service, manufacturer, or employer appointment authority.","content_classification":"crew_blueprint_framework","safety_criticality":"critical","authority_implication":"knowledge_only","publication_state":"noindex_review","supersedes_content_id":null,"superseded_by_content_id":null,"last_content_reviewed_at":"2026-08-31","notes":"Internal authority-state rule supported contextually by HR-01/02/03 external gates; the course may map interfaces without absorbing them."}
